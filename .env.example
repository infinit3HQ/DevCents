# DevCents self-hosting configuration. Copy to .env and fill in.
# Generate secrets with: openssl rand -hex 32

# ─── Version ────────────────────────────────────────────────────────────
# Pin to a release tag (see GitHub Releases) for predictable upgrades.
DEVCENTS_VERSION=latest
# Pin the Convex backend too, e.g. ghcr.io/convex/convex-backend:<tag>
CONVEX_BACKEND_IMAGE=ghcr.io/convex/convex-backend:latest

# ─── Public URLs ────────────────────────────────────────────────────────
# Where people open DevCents (used for OAuth/MCP metadata).
PUBLIC_URL=https://money.example.com
# Public URL of the Convex backend (browsers connect to it directly).
VITE_CONVEX_URL=https://convex.money.example.com
# true ONLY when every request reaches the app through your reverse proxy
# (keep WEB_BIND_ADDRESS=127.0.0.1 or a private network). If the app port is
# reachable directly, clients could fake X-Forwarded-For to dodge rate limits.
TRUST_PROXY=true

# Only needed with deployment/compose.caddy.yml
APP_DOMAIN=money.example.com
CONVEX_DOMAIN=convex.money.example.com

# ─── Convex backend ─────────────────────────────────────────────────────
# Letters, digits and underscores only (the Postgres database is named after it).
INSTANCE_NAME=devcents
INSTANCE_SECRET=
POSTGRES_PASSWORD=
# Fill in after the first start:
#   docker compose exec convex ./generate_admin_key.sh
CONVEX_SELF_HOSTED_ADMIN_KEY=

# ─── Auth (Clerk) ───────────────────────────────────────────────────────
# From your Clerk dashboard → API keys. The issuer is your Frontend API URL.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_ISSUER_URL=https://clerk.money.example.com

# ─── Server secret ──────────────────────────────────────────────────────
# Shared by the web container and Convex so OAuth endpoints can't be called
# directly against the Convex URL. At least 32 characters.
DEVCENTS_SERVER_SECRET=

# ─── Optional ───────────────────────────────────────────────────────────
# Single-user servers only: lets standard (non-remote) MCP tokens decrypt by
# deriving the key from this passphrase on the server. Leave empty to require
# per-token keys, which is safer.
DEVCENTS_PASSPHRASE=

# Bind addresses for the host ports (keep 127.0.0.1 behind a proxy).
WEB_BIND_ADDRESS=127.0.0.1
CONVEX_BIND_ADDRESS=127.0.0.1

# ─── Local development only (scripts/dev.sh) ────────────────────────────
# CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
